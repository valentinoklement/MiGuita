{
  "name": "miguita-grupos",
  "main": "grupos.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "GRUPOS", "class_name": "Grupo" }, { "name": "AVISOS", "class_name": "Aviso" }, { "name": "BUZON", "class_name": "Buzon" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Grupo"] }, { "tag": "v2", "new_sqlite_classes": ["Aviso"] }, { "tag": "v3", "new_sqlite_classes": ["Buzon"] }],
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "LIMITE_BUZON", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": { "VAPID_PUBLICA": "BCkqXJ-n_TyrDO4cRAaOUbgQq2ObDWAe1yCttqqTawwwm1EwO0U0Zq_VDy0MM0Sud-bN1s7ZYXEG-O9fnjHmiKY" },
  "observability": { "enabled": false }
}
